# Copy to deploy/.env.production and fill in. NEVER commit the real file.
# Generate secrets with:  openssl rand -hex 32
# (hex only — base64 output can contain / + = $ which break DATABASE_URL
#  and docker-compose variable interpolation)

# ---- Domain (single origin: app at https://DOMAIN, API at /api) ----
DOMAIN=radscribe.example.com
# Include only explicit HTTPS origins. If the separate admin console is used,
# host it on the same registrable domain so the Strict refresh cookie works.
CORS_ORIGIN=https://radscribe.example.com,https://admin.radscribe.example.com

# ---- Server ----
PORT=4000
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

# ---- Database (internal-only; no published ports) ----
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=radscribe
MYSQL_USER=radscribe
MYSQL_PASSWORD=

# ---- JWT (distinct long random strings) ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Throttle ----
THROTTLE_TTL=60
THROTTLE_LIMIT=120
REDIS_PASSWORD=
REDIS_URL=redis://:change-me@redis:6379

# ---- Registration ----
# Production starts invite-only. Deliberately enable self-registration only
# after an abuse review and support workflow are in place.
ALLOW_REGISTRATION=false
REQUIRE_PRIVILEGED_MFA=true

# ---- Bootstrap administrator (required by the one-time bootstrap job) ----
ADMIN_EMAIL=admin@your-org.example
ADMIN_PASSWORD=

# ---- Integration credential encryption (AES-256-GCM key material) ----
CREDENTIALS_KEY=

# ---- Google Sign-In (optional; empty disables the Google button) ----
# OAuth 2.0 Web client id from Google Cloud Console → Credentials.
# Add https://DOMAIN to the client's "Authorized JavaScript origins".
# The same id is baked into the web build (NEXT_PUBLIC_) and used by the API
# to verify ID tokens — keep both values identical.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- AI (Google Gemini — key stays server-side only) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSCRIPTION_MODEL=gemini-3.6-flash
# Set true only after a documented PHI/BAA review for this exact provider,
# account, region and model. Leave false/empty to disable AI in production.
AI_PHI_APPROVED=false

# ---- Encrypted offsite backups (S3 or compatible object storage) ----
# Use a dedicated least-privilege identity and enable bucket-side encryption,
# object versioning/immutability, retention, and access logging.
BACKUP_S3_URI=s3://your-private-backup-bucket/radscribe
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-1
BACKUP_SSE=AES256
# Optional for S3-compatible storage.
BACKUP_AWS_ENDPOINT_URL=
# Optional HTTPS endpoint for backup-failure alerting.
BACKUP_FAILURE_WEBHOOK_URL=

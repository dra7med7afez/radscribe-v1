# ---- Server ----
PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Database (MySQL 8) ----
# Inside docker compose the host is the service name "mysql".
DATABASE_URL=mysql://radscribe:radscribe@mysql:3306/radscribe
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=radscribe
MYSQL_USER=radscribe
MYSQL_PASSWORD=radscribe

# ---- Redis ----
REDIS_URL=redis://redis:6379

# ---- JWT ----
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---- Throttle ----
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ---- Seeded admin ----
# ADMIN_PASSWORD unset => seeded admin gets the dev default password and is
# forced to change it on first login. Set both explicitly in production.
ADMIN_EMAIL=admin@radscribe.local
#ADMIN_PASSWORD=

# ---- Integration credential encryption (AES-256-GCM) ----
CREDENTIALS_KEY=replace-with-a-32+-char-secret

# ---- AI (Gemini 3.1 Flash Lite) ----
AI_PROVIDER=gemini
GEMINI_API_KEY=            # provide your own; never commit
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TRANSCRIPTION_MODEL=gemini-3.6-flash
